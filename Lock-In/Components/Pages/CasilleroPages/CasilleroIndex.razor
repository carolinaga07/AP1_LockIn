@page "/Casilleros/Index"
@inject CasillerosService casillerosService
@inject ToastService toastService

<PageTitle>Index de Casilleros</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title m-0">
                Registro de Casilleros
            </h5>

            <a href="/Casilleros/Create" class="btn btn-primary">
                <i class="bi bi-plus-square me-2"></i>
                Nuevo Casillero
            </a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">

                @*filtar*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*valor filtro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Id">Id</option>
                        <option value="Fila">Fila</option>
                    </InputSelect>
                </div>
                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
             </div>
            
            <div class="table-responsive mt-3">
                @if (itemsQueryable is not null)
                {
                    <QuickGrid Items="@itemsQueryable"
                    Class="table table-hover align-middle text-center mt-3">

                        <PropertyColumn Property="@(c => c.CasilleroId)"
                        Title="ID"
                        Sortable="true" />

                        <PropertyColumn Property="@(c => c.Numero)"
                        Title="Número"
                        Sortable="true" />

                        <PropertyColumn Property="@(c => c.Fila)"
                        Title="Fila"
                        Sortable="true" />

                        <TemplateColumn Title="Estado">
                            <span class="badge @ObtenerClaseEstado(context.Estado) px-3 py-2">
                                @context.Estado
                            </span>
                        </TemplateColumn>

                        <TemplateColumn Title="Llave">
                            <span class="badge @(context.LlaveDisponible
                              ? "bg-success"
                              : "bg-danger") px-3 py-2">

                                @( context.LlaveDisponible )
                                                    </span>
                        </TemplateColumn>

                         <TemplateColumn Title="Opciones">
                           <div class="d-flex justify-content-center gap-2">
                              <a href="/Casilleros/Edit/@context.CasilleroId"
                                class="btn btn-outline-primary btn-sm"
                                 title="Editar casillero">
                                <i class="bi bi-pencil-square"></i>
                              </a>
                           </div>
                         </TemplateColumn>

                    </QuickGrid>
                }
            </div>

        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">

            <label>
                <strong>Cantidad:</strong>
                @itemsQueryable?.Count()
            </label>

            <label>
                <strong>Disponibles:</strong>
                @itemsQueryable?.Count(c => c.Estado == EstadoCasillero.Disponible)
            </label>

        </div>
    </div>
</div>

@code {
    private IQueryable<Casilleros>? itemsQueryable;
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await casillerosService.GetList(c => c.CasilleroId > 0);
        itemsQueryable = result.Value.AsQueryable();
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "" && Filtro == "Id")
        {
            int idBuscado = int.Parse(ValorFiltro);
            var result= await casillerosService.GetList(c => c.CasilleroId == idBuscado);
            itemsQueryable = result.Value.AsQueryable();
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Fila")
        {
            int filaBuscada = int.Parse(ValorFiltro);
            var result = await casillerosService.GetList(c => c.Fila == filaBuscada);
            itemsQueryable = result.Value.AsQueryable();
        }
    }

    private string ObtenerClaseEstado(EstadoCasillero estado)
    {
        switch (estado)
        {
            case EstadoCasillero.Disponible:
                return "est-disponible";
            case EstadoCasillero.Ocupado:
                return "est-ocupado";
            case EstadoCasillero.Inaccesible:
                return "est-inaccesible";
            default:
                return "est-disponible";
        }   
    }
}
