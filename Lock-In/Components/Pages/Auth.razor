@page "/auth"

@attribute [Authorize]

<PageTitle>Auth</PageTitle>

<h1>You are authenticated</h1>

<AuthorizeView>
    Hello @context.User.Identity?.Name!
</AuthorizeView>

<h4>Diagnóstico de usuario</h4>

<p>Usuario: @nombreUsuario</p>
<p>Autenticado: @autenticado</p>
<p>Es estudiante: @esEstudiante</p>
<p>Roles: @roles</p>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string nombreUsuario = "";
    private bool autenticado;
    private bool esEstudiante;
    private string roles = "";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var estado = await AuthenticationStateTask;
        var usuario = estado.User;

        nombreUsuario = usuario.Identity?.Name ?? "Sin usuario";
        autenticado = usuario.Identity?.IsAuthenticated ?? false;
        esEstudiante = usuario.IsInRole("Estudiante");

        roles = string.Join(", ",
            usuario.FindAll(System.Security.Claims.ClaimTypes.Role)
                .Select(r => r.Value));
    }
}