@inherits LayoutComponentBase

<Toasts class="p-3"
        AutoHide="true"
        StackLength="3"
        Placement="ToastsPlacement.TopRight" />

<div class="page">

    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>

    <main>

        <AuthorizeView>
            <Authorized>
                <header class="lock-topbar">

                    <a href="/Casilleros/Diagrama"
                       class="d-flex align-items-center text-decoration-none">

                        <img src="/images/lockin-robot.png"
                             alt="Lock-In"
                             class="lockin-header-logo" />

                    </a>

                    <div class="lock-topbar-actions">
                        <CampanaNotificaciones />
                    </div>

                </header>
            </Authorized>
        </AuthorizeView>

        <article class="content px-4">
            @Body
        </article>

    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
