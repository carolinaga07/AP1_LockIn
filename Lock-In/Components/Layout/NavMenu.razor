@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Lock-In</a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="(document.querySelector('.navbar-toggler') as HTMLInputElement)?.click()">
    <nav class="nav flex-column">

        @* ========================================= *@
        @* INICIO - TODOS LOS ROLES                  *@
        @* ========================================= *@

        <AuthorizeView Roles="Administrador,Bibliotecario,Estudiante">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/"
                             Match="NavLinkMatch.All">

                        <img src="/Imagenes/icons8-school-locker.svg"
                             alt="Casilleros"
                             class="nav-icon"
                             style="width: 39px; height: 39px; margin-right: 10px;" />

                        <span>Inicio - Casilleros</span>
                    </NavLink>

                    
                    <NavLink class="nav-link"
                             href="/Asignaciones/Index"
                             Match="NavLinkMatch.All">

                        <img src="/Imagenes/icons8-key.svg"
                             alt="Asignaciones"
                             class="nav-icon"
                             style="width: 39px; height: 39px; margin-right: 10px;" />

                        <span>Asignaciones</span>

                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Estudiante">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/Estudiante/MisSolicitudes">
                        <i class="bi bi-clipboard-check me-2"></i>
                        Mis Solicitudes
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* ========================================= *@
        @* ADMINISTRADOR                             *@
        @* ========================================= *@

        <AuthorizeView Roles="Administrador">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/administrador/usuarios">

                        <span class="bi bi-people-fill me-2"></span>
                        Gestión de Usuarios

                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* ========================================= *@
        @* ADMINISTRADOR Y BIBLIOTECARIO             *@
        @* ========================================= *@

        <AuthorizeView Roles="Administrador,Bibliotecario">
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/Solicitudes">

                        <span class="bi bi-clipboard-check-fill me-2"></span>
                        Gestión de Solicitudes

                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/Casilleros/Index">

                        <span class="bi bi-list-nested-nav-menu"
                              aria-hidden="true"></span>
                        Index Casilleros

                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/Inspecciones">

                        <span class="bi bi-clipboard-check-fill me-2"></span>
                        Gestión de Inspecciones

                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

        @* ========================================= *@
        @* PÁGINA DE PRUEBA DE AUTORIZACIÓN           *@
        @* ========================================= *@

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="auth"
                     Match="NavLinkMatch.All">

                <img src="/Imagenes/icons8-lock.svg"
                     alt="Auth Required"
                     class="nav-icon"
                     style="width: 33px; height: 39px; margin-right: 10px;" />

                <span>Auth Required</span>

            </NavLink>
        </div>

        @* ========================================= *@
        @* CUENTA Y CIERRE DE SESIÓN                  *@
        @* ========================================= *@

        <AuthorizeView>
            <Authorized Context="authContext">

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="Account/Manage">

                        <img src="/Imagenes/icons8-identification-documents.svg"
                             alt="Cuenta"
                             class="nav-icon"
                             style="width: 33px; height: 39px; margin-right: 10px;" />

                        <span>@authContext.User.Identity?.Name</span>

                    </NavLink>
                </div>

                
                
                <div class="nav-item px-3">
                    <form action="/Account/Logout"
                          method="post"
                          data-enhance="false">

                        <AntiforgeryToken />

                        <input type="hidden"
                               name="ReturnUrl"
                               value="/Account/Login" />

                        <button type="submit"
                                class="nav-link w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Cerrar sesión
                        </button>

                    </form>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager
            .ToBaseRelativePath(NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager
            .ToBaseRelativePath(e.Location);

        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
