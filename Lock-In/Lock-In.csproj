<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-Lock_In-d3a49b5a-1cfb-45c9-ade8-578e200dbb68</UserSecretsId>
		<RootNamespace>Lock_In</RootNamespace>
		<AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Blazor.Bootstrap"
						  Version="4.0.0" />

		<PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid"
						  Version="11.0.0" />

		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore"
						  Version="11.0.0" />

		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore"
						  Version="11.0.0" />

		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"
						  Version="11.0.0" />

		<PackageReference Include="Microsoft.EntityFrameworkCore.Design"
						  Version="11.0.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<PackageReference Include="Aplicada1.Core"
						  Version="1.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Lock-In.Core\Lock-In.Core.csproj" />
		<ProjectReference Include="..\Lock-In.Infrastructure\Lock-In.Infrastructure.csproj" />
	</ItemGroup>

</Project>
