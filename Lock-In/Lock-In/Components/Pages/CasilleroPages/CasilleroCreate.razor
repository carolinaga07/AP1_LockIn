@page "/Casilleros/Create" 
@inject CasillerosService casillerosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Agregar Casillero</PageTitle>
<EditForm Model="Casillero" OnValidSubmit="Guardar">
    <DataAnnotationsValidator/>

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Agregar Casillero</h5>
            </div>

            <div class="card-body">
                @*CasilleroId*@
                <div class="mb-3">
                    <label class="form-label"><strong>CasilleroId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Casillero.CasilleroId" readonly></InputNumber>
                </div>
                @*Numero*@
                <div class="mb-3">
                    <label class="form-label"><strong>N&uacute;mero de Casillero</strong></label>
                    <InputNumber class="form-control" @bind-Value="Casillero.Numero" ></InputNumber>
                </div>
                @*Fila*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fila</strong></label>
                    <InputNumber class="form-control" @bind-Value="Casillero.Fila"></InputNumber>
                </div>
            </div>
            @*footer*@
            <div class="card-footer text-center mt-2">
                <a href="Casilleros/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>
@code {
    public Casilleros Casillero { get; set; } = new Casilleros();

    public async Task Guardar()
    {
        bool existe = await casillerosService.ExisteCasillero(Casillero.Fila, Casillero.Numero, Casillero.CasilleroId);

        if (existe)
        {
            toastService.ShowError("Ya existe un casillero con ese número en la fila especificada.");
            return; 
        }

        var result = await casillerosService.Guardar(Casillero);

        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("¡Casillero guardado exitosamente!");
            navigationManager.NavigateTo("/Casilleros/Index");
        });

        result.OnFailure(() =>
        {
            toastService.ShowError("No se pudo guardar el casillero correctamente...");
        });
    }
}
