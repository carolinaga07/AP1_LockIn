@page "/Casilleros/Diagrama"
@rendermode InteractiveServer
@attribute [Authorize(Roles ="Administrador,Bibliotecario,Estudiante")]

@inject CasillerosService casillerosService
@inject SolicitudesService solicitudesService
@inject AuthenticationStateProvider authenticationStateProvider
@inject ToastService toastService
@inject NavigationManager navigationManager
@inject IJSRuntime JS



<PageTitle> Diagrama de Casilleros</PageTitle>
<div class="container-fluid px-4">
<div class="card shadow-lg">
    @*Encabezado*@
    <div class="card-header d-flex flex-column justify-content-between align-content-center mb-4">
        <h5 class="card-title m-0">Diagrama de Casilleros</h5>
    </div>

    <div class="card-body">
        @*Filtro*@
        <div class="row">
            <div class="col-3">
                <label class="col-form-label"><strong>Filtrar por Fila</strong></label>
            </div>
            <div class="col-4">
                <label class="col-form-label"><strong>Filtrar por Estado</strong></label>
            </div>
        </div>
        @*botones e inputs*@
        <div class="row align-items-center mb-4">
            <div class="col-3">
                <InputSelect class="form-select" @bind-Value="FilaSeleccionada">
                    <option value="1">Fila 1</option>
                    <option value="2">Fila 2</option>
                    <option value="3">Fila 3</option>
                    <option value="4">Fila 4</option>
                </InputSelect>
            </div>
            @*Filtrado por estado*@
            <div class="col-4">
                <div class="input-group">
                    <InputSelect class="form-select" @bind-Value="FiltroEstado">
                        <option value="">Todos los estados</option>
                        <option value="Disponible">Disponible</option>
                        <option value="Ocupado">Ocupado</option>
                        <option value="Inaccesible">Inaccesible</option>
                    </InputSelect>
                    <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                </div>
            </div>
        </div>
        @*Pestaña rapida para cambiar de fila*@
        <div class="row mb-4">
            <div class="col-12 d-flex gap-2">
                @for(int i = 1; i <= 4; i++)
                {
                    int numeroFila = i;
                    <button type="button" class="btn @(FilaSeleccionada == numeroFila ? "btn-primary shadow" : "btn-outline-secondary") px-4 fw-bold"
                            @onclick="() => SeleccionarFila(numeroFila)">
                        Fila @numeroFila
                    </button>
                }
            </div>
        </div>
        @*Fila Activa*@
        <div class="card bg-danger text-white p-2 shadow mb-2">
            <h5 class="m-0 fw-bold">Fila @FilaSeleccionada - Casilleros</h5>
        </div>
        @*cuadricula*@
        <div class="row g-3">
            @if (listaCasilleros == null)
            {
                <p class="text-center py-4">Cargando casilleros...</p>
            }else if(!listaCasilleros.Where(casillerosService => casillerosService.Fila == FilaSeleccionada).Any())
            {
                <div class="col-12 text-center py-5 text-muted bg-light rounded">
                    <p class="fs-5 m-0"> No hay casileros registrados en la fila @FilaSeleccionada.</p>
                </div>
            }
            else
            {
                @foreach (var casillero in ObtenerCasillerosFiltrados())
                {
                    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                        <div class="card cubo-casillero text-center p-3 shadow-sm border-2"
                                 style="cursor: @(EsEstudiante && casillero.Estado == EstadoCasillero.Disponible && casillero.LlaveDisponible ? "pointer" : "default")"
                                 data-bs-toggle="@(EsEstudiante && casillero.Estado == EstadoCasillero.Disponible && casillero.LlaveDisponible? "modal" : null)"
                                 data-bs-target="@(EsEstudiante && casillero.Estado == EstadoCasillero.Disponible && casillero.LlaveDisponible? "#modalSolicitar" : null)"
                                 @onclick="(() => SeleccionarCasillero(casillero))">
                            <div class="mb-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" style="@($"color: {ObtenerColorIcono(casillero.Estado)};")">
                                    <path d="M0 0h24v24H0z" fill="none" />
                                    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                        <path fill="currentColor" d="M6 4a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v16a2 2 0 0 1 -2 2H8a2 2 0 0 1 -2 -2Z" opacity=".2" stroke="none" />
                                        <path fill="currentColor" d="M14 14a1 1 0 1 0 2 0 1 1 0 1 0 -2 0" opacity=".2" stroke="none" />
                                        <path d="M6 4a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v16a2 2 0 0 1 -2 2H8a2 2 0 0 1 -2 -2Z" />
                                        <path d="M9 6h6" />
                                        <path d="M9 9h6" />
                                        <path d="M14 14a1 1 0 1 0 2 0 1 1 0 1 0 -2 0" />
                                    </g>
                                </svg>
                            </div>
                            <h6 class="fw-bold mb-2">N° @casillero.Numero</h6>
                            <div>
                                <span class="badge-estado @ObtenerEstado(casillero.Estado)">
                                    @casillero.Estado
                                </span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
            @if(EsEstudiante)
            {
               <div class="modal fade" id="modalSolicitar" tabindex="-1" aria-labelledby="tituloModalSolicitar" aria-hidden="true">
                   <div class="modal-dialog">
                       <div class="modal-content">
                           <div class="modal-header">
                               <h5 class="modal-title" id="tituloModalSolicitar">Confirmar Solicitud</h5>
                               <button type="button" class="btn btn-close" data-bs-dismiss="modal"></button>
                           </div>
                           <div class="modal-body">
                                @if(CasilleroSeleccionado != null)
                                {
                                    <p class="mb-2">Deseas solicitar el siguiente casillero?</p>
                                    <p class="mb-1"><strong>Fila:</strong>@CasilleroSeleccionado.Fila</p>
                                    <p class="mb-1"><strong>Numero:</strong>@CasilleroSeleccionado.Numero</p>
                                    <p class="mb-0"><strong>Estado:</strong>@CasilleroSeleccionado.Estado</p>
                                    @if(!string.IsNullOrEmpty(mensajeSolicitud) && !solicitudExitosa)
                                    {
                                        <div class="alert alert-danger mt-3">
                                            @mensajeSolicitud
                                        </div>
                                    }
                                }
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancelar</button>
                                <button type="button" class="btn btn-primary" disabled="@enviado" @onclick="SolicitarCasillero">@(enviado ? "Enviado..." : "Confirmar Solicitud")</button>
                            </div>
                       </div>
                   </div>
               </div>
            }

    </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <label class="ms-3"><strong>Fila @FilaSeleccionada - Cantidad de casilleros: </strong>@ObtenerCasillerosFiltrados().Count().</label>
        </div>
    </div>
</div>

@code{
    public int FilaSeleccionada { get; set; } = 1;
    public string FiltroEstado { get; set; } = string.Empty;
    public Casilleros casillero { get; set; } = new Casilleros();
    private List<Casilleros> listaCasilleros = new List<Casilleros>();
    public Casilleros? CasilleroSeleccionado { get; set; }
    private bool EsEstudiante = false;
    private bool enviado = false;
    private bool solicitudExitosa = false;
    private string? mensajeSolicitud;
    private string? usuarioId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        EsEstudiante = authState.User.IsInRole("Estudiante");
        usuarioId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await CargarCasilleros();

    }

    private async Task CargarCasilleros()
    {
        var result = await casillerosService.GetList(c => c.CasilleroId > 0);
        if (result.IsSuccess && result.Value != null)
        {
            listaCasilleros = result.Value;
        }
    }

    private void SeleccionarFila(int fila)
    {
        FilaSeleccionada = fila;
        CasilleroSeleccionado = null;
        mensajeSolicitud = null;
    }

    public async Task Buscar()
    {
        await CargarCasilleros();
        CasilleroSeleccionado = null;
        mensajeSolicitud = null;
    }

    private IEnumerable<Casilleros> ObtenerCasillerosFiltrados()
    {
        var result = listaCasilleros.Where(c => c.Fila == FilaSeleccionada);
        if (!string.IsNullOrEmpty(FiltroEstado) && Enum.TryParse<EstadoCasillero>(FiltroEstado, out var estadoEnum))
        {
            result = result.Where(c => c.Estado == estadoEnum);
        }
        return result;
    }

    private void SeleccionarCasillero(Casilleros casillero)
    {
        if(!EsEstudiante || enviado)
        {
            return;
        }

        if(casillero.Estado != EstadoCasillero.Disponible || !casillero.LlaveDisponible)
        {
            return;
        }
        CasilleroSeleccionado = casillero;
        mensajeSolicitud = null;
    }

    private async Task SolicitarCasillero()
    {
        if(!EsEstudiante || CasilleroSeleccionado == null || string.IsNullOrEmpty(usuarioId) || enviado)
        {
            return;
        }
        enviado = true;
        mensajeSolicitud = null;
        solicitudExitosa = false;

        try
        {
            var estudiante = await solicitudesService.BuscarEstudiantePorUsuario(usuarioId);
            if(estudiante == null)
            {
                mensajeSolicitud = "No se encontro tu registro de estudiante.";
                return;
            }

            var solicitud = new Solicitudes
                {
                    EstudianteId = estudiante.EstudianteId,
                    CasilleroId = CasilleroSeleccionado.CasilleroId
                };
            var resultado = await solicitudesService.GuardarSolicitudEstudiante(usuarioId, CasilleroSeleccionado.CasilleroId);
            if (resultado.IsSuccess)
            {
                solicitudExitosa = true;
                mensajeSolicitud = "La solicitud fue enviada correctamente";

                await JS.InvokeVoidAsync("cerrarModalBootstrap", "modalSolicitar");
                CasilleroSeleccionado = null;
                await CargarCasilleros();
            }
            else
            {
                mensajeSolicitud = "No se pudo registrar la solicitud";
            }
        }
        catch(Exception)
        {
            mensajeSolicitud = "Ocurrio un error al enviar la solicitud";
        }
        finally
        {
            enviado = false;
        }
    }

    private string ObtenerEstado(EstadoCasillero estado)
    {
        switch (estado)
        {
            case EstadoCasillero.Disponible:
                return "est-disponible";
            case EstadoCasillero.Ocupado:
                return "est-ocupado";
            case EstadoCasillero.Inaccesible:
                return "est-inaccesible";
            default:
                return "est-disponible";
        }   
    }

    private string ObtenerColorIcono(EstadoCasillero estado)
    {
        switch (estado)
        {
            case EstadoCasillero.Disponible:
                return "#416849";
            case EstadoCasillero.Ocupado:
                return "#8a4d4d";
            case EstadoCasillero.Inaccesible:
                return "#905a34";
            default:
                return "#416849";
        }
    }

    
}
