@page "/administrador/usuarios/edit/{UsuarioId}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

@inject UsuariosService usuariosService
@inject NavigationManager navigationManager
@inject ToastService toastService
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Editar Usuario</PageTitle>

<EditForm Model="Usuario" OnValidSubmit="Modificar" FormName="editarUsuario">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">

            <div class="card-header text-center">
                <h5 class="card-title">Editar Usuario</h5>
            </div>

            <div class="card-body">

                <ValidationSummary class="text-danger" />

                <div class="row mb-3">

                    <div class="col-6">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control"
                                   @bind-Value="Usuario.NombreCompleto" />
                        <ValidationMessage For="@(() => Usuario.NombreCompleto)" />
                    </div>

                    <div class="col-6">
                        <label class="form-label">Correo electrónico</label>
                        <InputText class="form-control"
                                   @bind-Value="Usuario.Email" />
                        <ValidationMessage For="@(() => Usuario.Email)" />
                    </div>

                </div>

                <div class="mb-3">
                    <label class="form-label">Rol</label>

                    <InputSelect class="form-select"
                                 @bind-Value="RolSeleccionado">
                        <option value="Administrador">Administrador</option>
                        <option value="Bibliotecario">Bibliotecario</option>
                    </InputSelect>
                </div>

            </div>

            <div class="card-footer text-center mt-2">

                <a href="/administrador/usuarios"
                   class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>

                <button type="button"
                        class="btn btn-outline-danger bi bi-trash"
                        data-bs-toggle="modal"
                        data-bs-target="#modalConfirmar"
                        @onclick="PrepararEliminar">
                    Eliminar
                </button>

                <button type="submit"
                        class="btn btn-primary bi bi-floppy">
                    Guardar
                </button>

            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="modalConfirmar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <p class="mb-0">@MensajeModal</p>
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        data-bs-dismiss="modal"
                        @onclick="ConfirmarModal">
                    Confirmar
                </button>

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string UsuarioId { get; set; } = string.Empty;

    public ApplicationUser Usuario { get; set; } = new();

    public string RolSeleccionado { get; set; } = string.Empty;

    public string MensajeModal { get; set; } = string.Empty;

    private Func<Task> AccionModal { get; set; } =
        () => Task.CompletedTask;

    protected override async Task OnInitializedAsync()
    {
        var usuario = await UserManager.FindByIdAsync(UsuarioId);

        if (usuario is null)
        {
            toastService.ShowError("No se encontró el usuario.");
            navigationManager.NavigateTo("/administrador/usuarios");
            return;
        }

        Usuario = usuario;

        var roles = await UserManager.GetRolesAsync(Usuario);
        RolSeleccionado = roles.FirstOrDefault() ?? string.Empty;
    }

    private async Task Modificar()
    {
        if (string.IsNullOrWhiteSpace(Usuario.NombreCompleto) ||
            string.IsNullOrWhiteSpace(Usuario.Email))
        {
            toastService.ShowError("El nombre y el correo son requeridos.");
            return;
        }

        var resultado = await UserManager.UpdateAsync(Usuario);

        if (!resultado.Succeeded)
        {
            toastService.ShowError(
                string.Join(" ", resultado.Errors.Select(e => e.Description)));
            return;
        }

        var rolesActuales = await UserManager.GetRolesAsync(Usuario);

        if (!rolesActuales.Contains(RolSeleccionado))
        {
            var eliminarRoles =
                await UserManager.RemoveFromRolesAsync(Usuario, rolesActuales);

            if (!eliminarRoles.Succeeded)
            {
                toastService.ShowError("No se pudo actualizar el rol.");
                return;
            }

            var agregarRol =
                await UserManager.AddToRoleAsync(Usuario, RolSeleccionado);

            if (!agregarRol.Succeeded)
            {
                toastService.ShowError("No se pudo asignar el nuevo rol.");
                return;
            }
        }

        toastService.ShowSuccess("Usuario modificado correctamente.");
        navigationManager.NavigateTo("/administrador/usuarios");
    }

    private async Task Eliminar()
    {
        var resultado = await UserManager.DeleteAsync(Usuario);

        if (resultado.Succeeded)
        {
            toastService.ShowSuccess("Usuario eliminado correctamente.");
            navigationManager.NavigateTo("/administrador/usuarios");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el usuario.");
        }
    }

    private void PrepararEliminar()
    {
        MensajeModal =
            $"¿Deseas eliminar al usuario {Usuario.NombreCompleto} ({Usuario.Email})?";

        AccionModal = Eliminar;
    }

    private async Task ConfirmarModal()
    {
        await AccionModal();
    }
}
